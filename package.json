{
  "name": "japanese-json",
  "version": "2.2.1",
  "description": "Japanese Syllabary in JSON format",
  "main": "index.js",
  "scripts": {
    "prepare": "husky install",
    "release": "release-it",
    "build:vocabulary": "node scripts/vocabulary.mjs",
    "validate:vocabulary": "node scripts/vocabulary.mjs --check",
    "update:vocabulary-source": "node scripts/update-vocabulary-source.mjs",
    "test": "npm run validate:vocabulary && node --test tests/*.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/merwan7/Japanese-JSON.git"
  },
  "keywords": [
    "japanese",
    "syllabary",
    "json"
  ],
  "author": "Merwan Rodriguez",
  "license": "SEE LICENSE IN LICENSES.md",
  "bugs": {
    "url": "https://github.com/merwan7/Japanese-JSON/issues"
  },
  "homepage": "https://github.com/merwan7/Japanese-JSON#readme",
  "devDependencies": {
    "husky": "^8.0.0",
    "lint-staged": "^13.2.2",
    "prettier": "^2.8.8",
    "release-it": "^16"
  }
}
